[[ -r /usr/share/omarchy/default/bash/env-bootstrap ]] && source /usr/share/omarchy/default/bash/env-bootstrap

[[ $- != *i* ]] && return

source "$OMARCHY_PATH/default/bash/rc"

PS0+='\e]133;C\e\\'

command_done() {
    printf '\e]133;D\e\\'
}
PROMPT_COMMAND=${PROMPT_COMMAND:+$PROMPT_COMMAND; }command_done

shopt -s autocd

bind '"\e[15~":"exec bash\n"'

_cycle_command() {
  local command=${READLINE_LINE%%[[:space:]]*}
  local rest=${READLINE_LINE#"$command"}

  case "$command" in
    cat)  command=tree ;;
    tree) command=cd ;;
    cd)   command=cat ;;
    *) return ;;
  esac

  READLINE_LINE="$command$rest"
  READLINE_POINT=${#READLINE_LINE}
}
bind -x '"\ec":_cycle_command'

_tldr_below_command() {
  local command=$READLINE_LINE
  [[ -z $command ]] && return

  # Save the current line and cursor; bind -x temporarily runs shell commands.
  local saved_line=$READLINE_LINE
  local saved_point=$READLINE_POINT

  printf '\n'
  tldr -- "$command" 2>/dev/null || tldr "${command%% *}"
  printf '\n'

  READLINE_LINE=$saved_line
  READLINE_POINT=$saved_point
  printf '\n'
}
bind -x '"\et":_tldr_below_command'

