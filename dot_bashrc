[[ -r /usr/share/omarchy/default/bash/env-bootstrap ]] && source /usr/share/omarchy/default/bash/env-bootstrap

[[ $- != *i* ]] && return

source "$OMARCHY_PATH/default/bash/rc"

PS0+='\e]133;C\e\\'

command_done() {
    printf '\e]133;D\e\\'
}
PROMPT_COMMAND=${PROMPT_COMMAND:+$PROMPT_COMMAND; }command_done

shopt -s autocd

bind '"\e[15~":"exec bash\n"'

_cycle_command() {
  local command=${READLINE_LINE%%[[:space:]]*}
  local rest=${READLINE_LINE#"$command"}

  case "$command" in
    cat)  command=tree ;;
    tree) command=cd ;;
    cd)   command=cat ;;
    *) return ;;
  esac

  READLINE_LINE="$command$rest"
  READLINE_POINT=${#READLINE_LINE}
}
bind -x '"\ec":_cycle_command'

